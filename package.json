{
  "name": "ragana",
  "version": "0.1.0",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "test": "bun test test/*.test.ts && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "bench": "node test/bench.mjs && node test/hashbench.mjs",
    "vendor": "sh tools/vendor.sh",
    "icons": "sh tools/icons.sh",
    "build:mac:intel": "bun scripts/build-desktop.ts mac:intel",
    "build:mac:silicon": "bun scripts/build-desktop.ts mac:silicon",
    "build:win": "bun scripts/build-desktop.ts win",
    "build:linux": "bun scripts/build-desktop.ts linux",
    "build:webpage": "bun scripts/build-webpage.ts",
    "build:npm": "bun scripts/build-npm.ts",
    "build:plugin": "bun scripts/build-plugin.ts",
    "build:all": "bun scripts/build-all.ts",
    "plugin:check": "bun scripts/build-plugin.ts --check",
    "verify": "sh tools/verify-standalone.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "description": "Локальный RAG на телефоне: папка с документами (текст/PDF/сканы) -> индекс -> ответы с цитатами. Ядро на WebView-совместимом JS, поверх — Android APK и Chrome-расширение.",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "sharp": "^0.35.5"
  }
}